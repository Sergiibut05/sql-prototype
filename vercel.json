{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npx ng build --configuration production",
    "outputDirectory": "dist/sql-prototype/browser",
    "framework": null,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}